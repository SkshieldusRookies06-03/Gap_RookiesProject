# 복사: cp .env.example .env  (.env는 커밋 금지 · EC2에서는 손으로 만들고 chmod 600)
# compose는 서비스별 environment에 필요한 키만 넘긴다(SPEC §1 · 점검서 A-5)
# 주석은 반드시 줄 단위로 — 값 뒤에 붙이면 kubectl --from-env-file이 값으로 읽는다
# 빈 값이면 compose가 기동을 거부한다(${VAR:?}) — 아래 네 개는 꼭 채운다: DB_PASSWORD · DB_ROOT_PASSWORD · JWT_SECRET · AI_INTERNAL_TOKEN
DB_NAME=jobgap
DB_USER=jobgap
DB_PASSWORD=
DB_ROOT_PASSWORD=
# 32바이트 이상 랜덤: openssl rand -base64 48
JWT_SECRET=
# 백엔드↔AI 내부 토큰: openssl rand -hex 32
AI_INTERNAL_TOKEN=
OPENAI_API_KEY=
TAVILY_API_KEY=
# 로컬 dev(5173). EC2는 http://<EC2 주소>
CORS_ALLOWED_ORIGINS=http://localhost:5173
ACTUATOR_EXPOSURE=health,info
