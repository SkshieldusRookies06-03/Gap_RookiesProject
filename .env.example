# 복사: cp .env.example .env  (.env는 커밋 금지 · EC2에서는 손으로 만들고 chmod 600)
# compose는 서비스별 environment에 필요한 키만 넘긴다(SPEC §1 · 점검서 A-5)
DB_NAME=jobgap
DB_USER=jobgap
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=                 # 32바이트 이상 랜덤 (openssl rand -base64 48)
AI_INTERNAL_TOKEN=          # 백엔드↔AI 내부 토큰 (openssl rand -hex 32)
OPENAI_API_KEY=
TAVILY_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173
ACTUATOR_EXPOSURE=health,info
VITE_API_URL=               # 로컬 dev는 http://localhost:8080 · 배포 빌드는 빈 값
